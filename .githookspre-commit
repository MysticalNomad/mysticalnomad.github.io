#!/usr/bin/env pwsh
$index = "index.html"
$today = Get-Date -Format "yyyy-MM-dd"
$content = Get-Content $index -Raw

if ($content -match '<!-- Last updated: \d{4}-\d{2}-\d{2} -->') {
    $content = $content -replace '<!-- Last updated: \d{4}-\d{2}-\d{2} -->', "<!-- Last updated: $today -->"
} else {
    $content = "<!-- Last updated: $today -->`r`n$content"
}

Set-Content -Path $index -Value $content -NoNewline
git add $index